<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # Apache 2.4 - Block dotfiles & sensitive environment files
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>

    <Files ".env">
        Require all denied
    </Files>

    <FilesMatch "(composer\.(json|lock)|package\.json|\.sql|\.zip)$">
        Require all denied
    </FilesMatch>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Direct access to favicon, robots, and sitemaps from root
    RewriteCond %{REQUEST_URI} ^/(favicon.*|apple-touch-icon.*|robots\.txt|sitemap.*\.xml)$ [NC]
    RewriteRule ^ - [L]

    # Route everything else safely to public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_mime.c>
    AddType image/x-icon .ico
    AddType image/png .png
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit