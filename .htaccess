DirectoryIndex public/index.php index.php

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>
# Block access to .env and other hidden files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Specifically block .env (extra safety)
<Files ".env">
    Order allow,deny
    Deny from all
</Files>
    RewriteEngine On

    # Route root URL directly to public/index.php to prevent 403 directory listing error
    RewriteRule ^$ public/index.php [L]

    # Explicit route for dynamic sitemap to prevent 404 status code
    RewriteRule ^sitemap\.xml$ public/index.php [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 301 Redirect legacy /public/ favicon and icon requests to root (only direct client requests)
    RewriteCond %{THE_REQUEST} \s/+public/(favicon[^\s\?]*|apple-touch-icon[^\s\?]*) [NC]
    RewriteCond %{HTTP:X-Forwarded-Proto} =https [OR]
    RewriteCond %{HTTPS} on
    RewriteRule ^public/(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+public/(favicon[^\s\?]*|apple-touch-icon[^\s\?]*) [NC]
    RewriteRule ^public/(.*)$ /$1 [R=301,L]

    # Serve static assets directly from public/ if requested from root
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ public/index.php [L]
</IfModule>

<IfModule mod_mime.c>
    AddType image/x-icon .ico
    AddType image/png .png
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
